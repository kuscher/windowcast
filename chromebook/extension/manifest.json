{
  "manifest_version": 3,
  "name": "Windowcast",
  "version": "0.1.0",
  "description": "Share one window of this Chromebook with your Googlebook, keep the Chromebook awake, and control the window from there.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Share this window with Windowcast",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["desktopCapture", "debugger", "tabs", "power", "storage", "search"]
}
